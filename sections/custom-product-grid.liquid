<div class="custom-product-grid-section">
  <div class="grid-container">
    {%- assign featured_collection = collections[section.settings.collection_handle] -%}
    
    <div class="products-flex-grid">
      {%- if featured_collection and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          <div class="product-item-card">
            <a href="{{ product.url }}" class="product-card-link">
              <div class="product-image-wrapper">
                {%- if product.featured_image != blank -%}
                  <img src="{{ product.featured_image | image_url: width:600 }}" alt="{{ product.title | escape }}" class="product-main-img" loading="lazy" width="300" height="400">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg-graphic' }}
                {%- endif -%}
              </div>
              
              <div class="product-info-meta">
                <h3 class="product-item-title">{{ product.title }}</h3>
                <span class="product-item-price">{{ product.price | money }}</span>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..8) -%}
          <div class="product-item-card">
            <div class="product-image-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg-graphic' }}
            </div>
            <div class="product-info-meta">
              <h3 class="product-item-title">Sample Product Title</h3>
              <span class="product-item-price">$50.00</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .custom-product-grid-section {
    width: 100%;
    background-color: #ffffff;
    padding: 40px 80px;
    box-sizing: border-box;
    font-family: 'Jost', sans-serif;
  }
  .grid-container {
    max-width: 1440px;
    margin: 0 auto;
  }
  .products-flex-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .product-item-card {
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .product-card-link {
    text-decoration: none;
    color: #000000;
    display: block;
  }
  .product-image-wrapper {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f5f5f5;
    line-height: 0;
  }
  .product-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .product-item-card:hover .product-main-img {
    transform: scale(1.03);
  }
  .placeholder-svg-graphic {
    width: 100%;
    height: 100%;
    background-color: #f2f2f2;
  }
  .product-info-meta {
    padding: 15px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .product-item-title {
    font-size: 14px;
    font-weight: 500;
    margin: 0;
    color: #000000;
    text-transform: capitalize;
  }
  .product-item-price {
    font-size: 14px;
    font-weight: bold;
    color: #000000;
  }

  @media (max-width: 1199px) {
    .products-flex-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 991px) {
    .custom-product-grid-section {
      padding: 30px 40px;
    }
    .products-flex-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px;
    }
  }
  @media (max-width: 575px) {
    .custom-product-grid-section {
      padding: 20px 15px;
    }
    .products-flex-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .product-item-title {
      font-size: 13px;
    }
    .product-item-price {
      font-size: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection_handle",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 4,
      "default": 8,
      "label": "Number of products to display"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}