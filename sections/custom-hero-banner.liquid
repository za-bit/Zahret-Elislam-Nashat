<div class="custom-hero-banner-section">
  <div class="banner-announcement-bar">
    <p>{{ section.settings.announcement_text }}</p>
  </div>

  <div class="banner-top-line-container">
    <img src="{{ 'banner-top-line.svg' | asset_url }}" alt="Line Art Pattern" class="top-line-graphic" width="1440" height="390" loading="lazy">
  </div>

  <div class="banner-main-wrapper">
    <div class="banner-container">
      <div class="banner-content-box">
        <h1 class="banner-logo-title">{{ section.settings.logo_text }}</h1>
        <h2 class="banner-main-heading">{{ section.settings.main_heading }}</h2>
        <p class="banner-description">{{ section.settings.description_text }}</p>
        
        <a href="{{ section.settings.button_url }}" class="banner-action-btn">
          {{ section.settings.button_text }}
          <span class="btn-arrow">→</span>
        </a>
      </div>

      <div class="banner-graphic-box">
        <img src="{{ 'banner-right-graphic.svg' | asset_url }}" alt="Featured Graphic" class="right-inner-graphic" width="890" height="402" loading="lazy">
      </div>
    </div>
  </div>
</div>

<style>
  .custom-hero-banner-section {
    width: 100%;
    font-family: sans-serif;
    box-sizing: border-box;
    background-color: #ffffff;
    position: relative;
    overflow: hidden;
  }
  .banner-announcement-bar {
    background-color: #ffffff;
    text-align: center;
    padding: 12px 10px;
    font-size: 11px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #000000;
    border-bottom: 1px solid #000000;
  }
  .banner-top-line-container {
    width: 100%;
    height: auto;
    display: block;
    line-height: 0;
  }
  .top-line-graphic {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .banner-main-wrapper {
    width: 100%;
    position: relative;
  }
  .banner-container {
    display: flex;
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px 80px;
    align-items: center;
    justify-content: space-between;
  }
  .banner-content-box {
    flex: 1;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
  }
  .banner-logo-title {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 40px;
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  .banner-main-heading {
    font-size: 54px;
    line-height: 1.1;
    margin-bottom: 20px;
    font-weight: 500;
    letter-spacing: -1px;
  }
  .banner-description {
    font-size: 14px;
    line-height: 1.6;
    color: #333333;
    margin-bottom: 40px;
  }
  .banner-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    background-color: #000000;
    color: #ffffff;
    padding: 14px 30px;
    text-decoration: none;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: bold;
    width: 200px;
    transition: all 0.3s ease;
  }
  .banner-action-btn:hover {
    background-color: #333333;

  }
  .btn-arrow {

    transition: transform 0.3s ease;
  }
  .banner-action-btn:hover .btn-arrow {
    transform: translateX(5px);
  }
  .banner-graphic-box {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    max-width: 650px;
  }
  .right-inner-graphic {
    width: 100%;
    height: auto;
    max-width: 100%;
    object-fit: contain;
  }

  @media (max-width: 991px) {
    .banner-container {
      padding: 40px 40px;
    }
    .banner-main-heading {
      font-size: 42px;
    }
  }

  @media (max-width: 768px) {
    .banner-container {
      flex-direction: column-reverse;
      padding: 40px 20px;
      text-align: center;
    }
    .banner-content-box {
      max-width: 100%;
      align-items: center;
      margin-top: 30px;
    }
    .banner-graphic-box {
      max-width: 100%;
      justify-content: center;
    }
    .banner-action-btn {
      width: 100%;

    }
  }
</style>

{% schema %}
{
  "name": "Custom Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo / Brand Text",
      "default": "TISSO VISON"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description_text",
      "label": "Description Text",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}
