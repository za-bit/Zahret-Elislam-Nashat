<div class="custom-product-grid-section">
  <div class="grid-container">
    <div class="grid-section-header">
      <h2 class="grid-section-title">{{ section.settings.section_title }}</h2>
    </div>

    {%- assign featured_collection = collections[section.settings.collection_handle] -%}
    
    <div class="products-flex-grid">
      {%- if featured_collection and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          <div class="product-item-card">
            <a href="{{ product.url }}" class="product-card-link">
              <div class="product-image-wrapper">
                {%- if product.featured_image != blank -%}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="product-main-img" loading="lazy" width="300" height="400">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg-graphic' }}
                {%- endif -%}
                
                <div class="product-card-overlay">
                  <span class="quick-view-text">View Details</span>
                </div>
              </div>
              
              <div class="product-info-meta">
                <div class="product-title-row">
                  <h3 class="product-item-title">{{ product.title }}</h3>
                </div>
                <div class="product-details-row">
                  <span class="product-item-price">{{ product.price | money }}</span>
                  {%- if product.variants.size > 0 -%}
                    <span class="product-item-sizes">
                      {%- for option in product.options_with_values -%}
                        {%- if option.name == 'Size' or option.name == 'size' -%}
                          {{ option.values.size }} Sizes
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                  {%- endif -%}
                </div>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- else -%}
        
        {%- for i in (1..4) -%}
          <div class="product-item-card">
            <div class="product-image-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg-graphic' }}
              <div class="product-card-overlay">
                <span class="quick-view-text">View Details</span>
              </div>
            </div>
            <div class="product-info-meta">
              <div class="product-title-row">
                <h3 class="product-item-title">Sample Product Title</h3>
              </div>
              <div class="product-details-row">
                <span class="product-item-price">$120.00</span>
                <span class="product-item-sizes">6 Sizes</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .custom-product-grid-section {
    width: 100%;
    background-color: #ffffff;
    padding: 60px 80px;
    box-sizing: border-box;
    font-family: 'Jost', sans-serif;

  }
  .grid-container {
    max-width: 1440px;
    margin: 0 auto;
  }
  .grid-section-header {
    width: 100%;
    margin-bottom: 40px;
    text-align: left;
  }
  .grid-section-title {
    font-size: 32px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #000000;
    margin: 0;
  }
  .products-flex-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .product-item-card {
    background-color: #ffffff;
    display: flex;
    flex-direction: column;
    position: relative;

  }
  .product-card-link {
    text-decoration: none;
    color: #000000;
    display: block;
  }
  .product-image-wrapper {
    width: 100%;
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #f5f5f5;
    line-height: 0;
    border: 1px solid #000000;
  }
  .product-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }


  .product-card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .quick-view-text {
    background-color: #ffffff;
    color: #000000;
    padding: 10px 20px;
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: 1px solid #000000;
  }
  .product-item-card:hover .product-main-img {
    transform: scale(1.02);
  }
  .product-item-card:hover .product-card-overlay {
    opacity: 1;
  }

  .product-info-meta {
    padding: 16px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .product-title-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .product-item-title {
    font-size: 15px;
    font-weight: 500;
    margin: 0;
    color: #000000;
    line-height: 1.3;
  }
  .product-details-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 4px;
  }
  .product-item-price {
    font-size: 14px;
    font-weight: bold;
    color: #000000;
  }
  .product-item-sizes {
    font-size: 12px;
    color: #666666;
  }

  /* Responsive Mobile Media Queries */
  @media (max-width: 767px) {
    .custom-product-grid-section {
      padding: 30px 16px;
    }
    .grid-section-header {
      margin-bottom: 20px;
    }
    .grid-section-title {
      font-size: 20px;
      letter-spacing: 0.5px;
    }
    .products-flex-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .product-image-wrapper {
      aspect-ratio: 1 / 1;
    }
    .product-info-meta {
      padding: 10px 0;
      gap: 4px;
    }
    .product-item-title {
      font-size: 13px;
    }
    .product-item-price {
      font-size: 13px;
    }
    .product-item-sizes {
      font-size: 11px;
    }
    .product-card-overlay {
      display: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "TISSO VISON IN THE WILD"
    },
    {
      "type": "collection",
      "id": "collection_handle",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 4,
      "default": 8,
      "label": "Number of products to display"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Grid"
    }
  ]
}
{% endschema %}